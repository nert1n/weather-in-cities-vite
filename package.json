{
	"name": "weather-in-cities-vite",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"build": "tsc -b && vite build",
		"lint": "pnpm run lint:ts && pnpm run lint:css",
		"lint:fix": "pnpm run lint:ts:fix && pnpm run lint:css:fix",
		"lint:ts": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"lint:ts:fix": "eslint . --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
		"lint:css": "stylelint \"src/**/*.scss\"",
		"lint:css:fix": "stylelint \"src/**/*.scss\" --fix --max-warnings 0",
		"format": "prettier --write .",
		"preview": "vite preview",
		"prepare": "husky && husky install"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.6.1",
		"@tanstack/react-query": "^5.69.0",
		"axios": "^1.8.4",
		"i18next": "^23.16.8",
		"i18next-browser-languagedetector": "^8.0.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.54.2",
		"react-i18next": "^14.1.3",
		"react-redux": "^9.2.0",
		"react-router-dom": "^6.30.0"
	},
	"devDependencies": {
		"@types/node": "^22.13.11",
		"@types/react": "^18.3.19",
		"@types/react-dom": "^18.3.5",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vitejs/plugin-legacy": "^5.4.3",
		"@vitejs/plugin-react-swc": "^3.8.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.21",
		"eslint": "^8.57.1",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^3.9.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-optimize-regex": "^1.2.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-security": "^3.0.1",
		"eslint-plugin-sonarjs": "^2.0.4",
		"eslint-plugin-sort-destructure-keys": "^2.0.0",
		"eslint-plugin-unicorn": "^55.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"postcss": "^8.5.3",
		"postcss-load-config": "^6.0.1",
		"postcss-nesting": "^12.1.5",
		"prettier": "^3.5.3",
		"sass": "1.78.0",
		"stylelint": "^16.16.0",
		"stylelint-config-standard": "^36.0.1",
		"stylelint-config-standard-scss": "^13.1.0",
		"stylelint-declaration-block-no-ignored-properties": "^2.8.0",
		"stylelint-scss": "^6.11.1",
		"sugarss": "^4.0.1",
		"typescript": "5.5.4",
		"vite": "^5.4.14",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-pwa": "^0.20.5",
		"vite-plugin-sitemap": "^0.7.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.ts": [
			"eslint --cache --fix",
			"git add ."
		],
		"*.tsx": [
			"eslint --cache --fix",
			"git add ."
		],
		"*.scss": [
			"stylelint --fix",
			"git add ."
		]
	}
}
